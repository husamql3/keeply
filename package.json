{
	"name": "keeply",
	"version": "0.0.0",
	"private": true,
	"description": "Keeply is a bookmark manager that helps you save, organize, and find anything from the web.",
	"license": "MIT",
	"author": "",
	"workspaces": [
		"apps/*"
	],
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"dev": "turbo dev",
		"dev:server": "turbo -F server dev",
		"build": "turbo build",
		"build:server": "turbo -F server build",
		"format": "bunx oxlint && bunx oxfmt --write"
	},
	"engines": {
		"bun": ">=1.3.10",
		"node": ">=18"
	},
	"packageManager": "bun@1.3.10"
}
